// This is your Prisma schema file.
// Aligned with infrastructure/backend/database_schema.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── SaaS Foundation (Phase 5) ───────────────────────────

model Tenant {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  plan     String  @default("free") // free | starter | pro
  settings String? // JSON string for tenant-specific configs

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  users            User[]
  roles            Role[]
  auditLogs        AuditLog[]
  customers        Customer[]
  tags             Tag[]
  suppliers        Supplier[]
  categories       ProductCategory[]
  products         Product[]
  orders           Order[]
  transactions     InventoryTransaction[]
  expenses         Expense[]
  interactions     Interaction[]
  shifts           Shift[]
  productBatches   ProductBatch[]
  dailySettlements DailySettlement[]
  accountingSyncLogs AccountingSyncLog[]
  messageBroadcasts  MessageBroadcast[]
  orderPayments      OrderPayment[]

  @@map("tenants")
}

// ─── IAM & RBAC ──────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  fullName            String    @map("full_name")
  status              String    @default("active") // active | suspended | pending_verification
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  totpSecret          String?   @map("totp_secret")
  tenantId            String    @map("tenant_id")
  employeeCode        String?   @unique @map("employee_code")

  // Audit fields
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]
  auditLogs AuditLog[]
  shifts    Shift[]
  salesOrders  Order[] @relation("SalesOrders")

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")
  tenantId    String  @map("tenant_id")

  // Audit fields
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  action      String // read, create, update, delete, approve
  resource    String // users, roles, audit_logs
  description String?

  // Audit fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─── Security & Auditing ─────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String // e.g., UPDATE_USER_ROLE, CREATE_USER
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  oldValue     String?  @map("old_value") @db.Text
  newValue     String?  @map("new_value") @db.Text
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([tenantId])
  @@map("audit_logs")
}

// ─── CRM (Phase 3) ───────────────────────────────────────

model Customer {
  id       String    @id @default(uuid())
  name     String?
  phone      String? @map("phone")
  lineUid    String? @map("line_uid")
  lineUserId String? @unique @map("line_user_id")
  gender   String?
  birthday DateTime?
  tenantId String    @map("tenant_id")

  // Cache fields for Dashboard / Quick access
  totalSpent          Int       @default(0) @map("total_spent")
  purchaseCount       Int       @default(0) @map("purchase_count")
  lastPurchaseDate    DateTime? @map("last_purchase_date")
  lastInteractionDate DateTime? @map("last_interaction_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags         CustomerTag[]
  interactions Interaction[]
  orders       Order[]

  @@unique([phone, tenantId])
  @@unique([lineUid, tenantId])
  @@index([tenantId])
  @@map("customers")
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String?
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers CustomerTag[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("tags")
}

model CustomerTag {
  customerId String @map("customer_id")
  tagId      String @map("tag_id")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tags")
}

model Interaction {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  type         String // LINE_MESSAGE, STORE_VISIT, PHONE_CALL, SYSTEM_NOTICE
  content      String? // The text content or notes
  tenantId     String   @map("tenant_id")
  interactedAt DateTime @default(now()) @map("interacted_at")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId])
  @@index([interactedAt])
  @@map("interactions")
}

// ─── Inventory & Suppliers (Phase 3) ──────────────────────

model Supplier {
  id          String  @id @default(uuid())
  name        String
  contactName String? @map("contact_name")
  email       String?
  phone       String?
  address     String?
  tenantId    String  @map("tenant_id")

  // Performance metrics
  rating              Int? // 1-5 scale or 0-100
  deliveryReliability Float? @map("delivery_reliability") // Percentage
  defectRate          Float? @map("defect_rate") // Percentage

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("suppliers")
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id          String  @id @default(uuid())
  sku         String
  name        String
  description String?
  tenantId    String  @map("tenant_id")

  categoryId String? @map("category_id")
  supplierId String? @map("supplier_id")

  costPrice   Decimal @map("cost_price")   @db.Decimal(12, 4)
  retailPrice Decimal @map("retail_price") @db.Decimal(12, 4)

  stockQuantity Int @default(0) @map("stock_quantity")
  safetyStock   Int @default(10) @map("safety_stock")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     ProductCategory?       @relation(fields: [categoryId], references: [id])
  supplier     Supplier?              @relation(fields: [supplierId], references: [id])
  orderItems   OrderItem[]
  transactions InventoryTransaction[]
  batches      ProductBatch[]

  @@unique([sku, tenantId])
  @@index([tenantId])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

// ─── Orders & Transactions (Phase 4) ──────────────────────

model Order {
  id              String  @id @default(uuid())
  customerId      String  @map("customer_id")
  status          String  @default("pending") // pending | paid | shipped | completed | cancelled
  totalAmount     Decimal @map("total_amount")    @db.Decimal(12, 4)
  paymentStatus   String  @default("unpaid") @map("payment_status")
  shippingAddress String? @map("shipping_address")
  tenantId        String  @map("tenant_id")

  // Phase 8: Sales foundation fields (all backward-compatible)
  orderNumber   String? @map("order_number")                          // e.g. "ORD-20240516-001"
  orderType     String  @default("WALK_IN") @map("order_type")        // WALK_IN | ONLINE | PHONE | SYSTEM
  paymentMethod String  @default("CASH") @map("payment_method")       // CASH | CARD | LINE_PAY | TRANSFER | OTHER
  shiftId       String? @map("shift_id")                              // FK to Shift, nullable
  discountAmount Decimal @default(0)  @map("discount_amount") @db.Decimal(12, 4)
  discountNote   String?              @map("discount_note")
  salesStaffId   String?              @map("sales_staff_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer       @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  payments   OrderPayment[]
  shift      Shift?         @relation(fields: [shiftId], references: [id])
  salesStaff User?          @relation("SalesOrders", fields: [salesStaffId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([shiftId])
  @@index([orderNumber])
  @@index([salesStaffId])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  quantity  Int
  unitPrice      Decimal  @map("unit_price")      @db.Decimal(12, 4)
  discountRate   Float    @default(0)  @map("discount_rate")
  finalUnitPrice Decimal? @map("final_unit_price") @db.Decimal(12, 4)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─── Phase 9.7: Split Payment ─────────────────────────────

model OrderPayment {
  id       String  @id @default(uuid())
  orderId  String  @map("order_id")
  tenantId String  @map("tenant_id")
  method   String                        // CASH | CARD | LINE_PAY | TRANSFER | OTHER
  amount   Decimal @db.Decimal(12, 4)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@map("order_payments")
}

model InventoryTransaction {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  type        String // IN (Purchase/Restock) | OUT (Sale/Order) | ADJUSTMENT
  quantity    Int
  referenceId String?  @map("reference_id") // Order ID or Purchase ID
  notes       String?
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("inventory_transactions")
}

// ─── Financial Tracking (Phase 5) ─────────────────────────

model Expense {
  id          String   @id @default(uuid())
  type        String // RENT | SALARY | MARKETING | LOGISTICS | OTHER
  amount      Decimal @db.Decimal(12, 4)
  description String?
  period      String // YYYY-MM
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([period])
  @@map("expenses")
}

// ─── Phase 8: Sales Foundation ────────────────────────────

model Shift {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  staffId     String    @map("staff_id")       // FK to User (值班人員)
  status      String    @default("OPEN")       // OPEN | CLOSED
  openingCash Decimal   @default(0) @map("opening_cash") @db.Decimal(12, 4) // 開班金額
  closingCash Decimal?  @map("closing_cash")   @db.Decimal(12, 4)            // 交班金額 (收班後填入)
  openedAt    DateTime  @default(now()) @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  notes       String?

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff       User              @relation(fields: [staffId], references: [id])
  orders      Order[]
  settlements DailySettlement[]

  @@index([tenantId])
  @@index([staffId])
  @@index([status])
  @@map("shifts")
}

model ProductBatch {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  tenantId    String   @map("tenant_id")
  batchNumber String   @map("batch_number")   // 批號，如 "LOT-20240101"
  expiryDate  DateTime @map("expiry_date")    // 到期日
  quantity    Int      @default(0)            // 此批次剩餘庫存
  costPrice   Decimal  @map("cost_price")     @db.Decimal(12, 4) // 此批次進貨成本
  receivedAt  DateTime @default(now()) @map("received_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, batchNumber, tenantId])
  @@index([tenantId])
  @@index([productId])
  @@index([expiryDate])
  @@map("product_batches")
}

model DailySettlement {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  shiftId       String    @map("shift_id")
  date          DateTime  // 結算日期
  totalSales    Decimal   @default(0) @map("total_sales")     @db.Decimal(12, 4) // 總銷售金額
  totalOrders   Int       @default(0) @map("total_orders")                       // 訂單數量
  cashAmount    Decimal   @default(0) @map("cash_amount")     @db.Decimal(12, 4)
  cardAmount    Decimal   @default(0) @map("card_amount")     @db.Decimal(12, 4)
  linePayAmount Decimal   @default(0) @map("line_pay_amount") @db.Decimal(12, 4)
  otherAmount   Decimal   @default(0) @map("other_amount")    @db.Decimal(12, 4)
  confirmedAt   DateTime? @map("confirmed_at") // 確認日結時間
  notes         String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift  Shift  @relation(fields: [shiftId], references: [id])

  @@unique([shiftId, date])
  @@index([tenantId])
  @@index([date])
  @@map("daily_settlements")
}

// ─── Phase 6: External Integrations (INT-03) ──────────────

model AccountingSyncLog {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  provider     String    // mock | quickbooks | xero
  entityType   String    @map("entity_type")   // order | expense
  entityId     String    @map("entity_id")
  externalId   String?   @map("external_id")
  status       String    @default("pending")    // pending | synced | failed
  errorMessage String?   @map("error_message")
  syncedAt     DateTime? @map("synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId])
  @@map("accounting_sync_logs")
}

// ─── Phase 6: LINE Integration (INT-01) ───────────────────

model MessageBroadcast {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  title         String
  content       String    @db.Text
  targetSegment String    @map("target_segment") // all | vip | first_time | at_risk
  sentCount     Int       @default(0) @map("sent_count")
  status        String    @default("pending") // pending | sent | failed | partial
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@map("message_broadcasts")
}
