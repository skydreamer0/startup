// This is your Prisma schema file.
// Aligned with infrastructure/backend/database_schema.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── SaaS Foundation (Phase 5) ───────────────────────────

model Tenant {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  plan     String  @default("free") // free | starter | pro
  settings String? // JSON string for tenant-specific configs

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  users        User[]
  roles        Role[]
  auditLogs    AuditLog[]
  customers    Customer[]
  tags         Tag[]
  suppliers    Supplier[]
  categories   ProductCategory[]
  products     Product[]
  orders       Order[]
  transactions InventoryTransaction[]
  expenses     Expense[]
  interactions Interaction[]

  @@map("tenants")
}

// ─── IAM & RBAC ──────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  fullName            String    @map("full_name")
  status              String    @default("active") // active | suspended | pending_verification
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  totpSecret          String?   @map("totp_secret")
  tenantId            String    @map("tenant_id")

  // Audit fields
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]
  auditLogs AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")
  tenantId    String  @map("tenant_id")

  // Audit fields
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  action      String // read, create, update, delete, approve
  resource    String // users, roles, audit_logs
  description String?

  // Audit fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─── Security & Auditing ─────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String // e.g., UPDATE_USER_ROLE, CREATE_USER
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  oldValue     String?  @map("old_value") @db.Text
  newValue     String?  @map("new_value") @db.Text
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([tenantId])
  @@map("audit_logs")
}

// ─── CRM (Phase 3) ───────────────────────────────────────

model Customer {
  id       String    @id @default(uuid())
  name     String?
  phone    String?   @map("phone")
  lineUid  String?   @map("line_uid")
  gender   String?
  birthday DateTime?
  tenantId String    @map("tenant_id")

  // Cache fields for Dashboard / Quick access
  totalSpent          Int       @default(0) @map("total_spent")
  purchaseCount       Int       @default(0) @map("purchase_count")
  lastPurchaseDate    DateTime? @map("last_purchase_date")
  lastInteractionDate DateTime? @map("last_interaction_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags         CustomerTag[]
  interactions Interaction[]
  orders       Order[]

  @@unique([phone, tenantId])
  @@unique([lineUid, tenantId])
  @@index([tenantId])
  @@map("customers")
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String?
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers CustomerTag[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("tags")
}

model CustomerTag {
  customerId String @map("customer_id")
  tagId      String @map("tag_id")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tags")
}

model Interaction {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  type         String // LINE_MESSAGE, STORE_VISIT, PHONE_CALL, SYSTEM_NOTICE
  content      String? // The text content or notes
  tenantId     String   @map("tenant_id")
  interactedAt DateTime @default(now()) @map("interacted_at")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId])
  @@index([interactedAt])
  @@map("interactions")
}

// ─── Inventory & Suppliers (Phase 3) ──────────────────────

model Supplier {
  id          String  @id @default(uuid())
  name        String
  contactName String? @map("contact_name")
  email       String?
  phone       String?
  address     String?
  tenantId    String  @map("tenant_id")

  // Performance metrics
  rating              Int? // 1-5 scale or 0-100
  deliveryReliability Float? @map("delivery_reliability") // Percentage
  defectRate          Float? @map("defect_rate") // Percentage

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("suppliers")
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id          String  @id @default(uuid())
  sku         String
  name        String
  description String?
  tenantId    String  @map("tenant_id")

  categoryId String? @map("category_id")
  supplierId String? @map("supplier_id")

  costPrice   Float @map("cost_price")
  retailPrice Float @map("retail_price")

  stockQuantity Int @default(0) @map("stock_quantity")
  safetyStock   Int @default(10) @map("safety_stock")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     ProductCategory?       @relation(fields: [categoryId], references: [id])
  supplier     Supplier?              @relation(fields: [supplierId], references: [id])
  orderItems   OrderItem[]
  transactions InventoryTransaction[]

  @@unique([sku, tenantId])
  @@index([tenantId])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

// ─── Orders & Transactions (Phase 4) ──────────────────────

model Order {
  id              String  @id @default(uuid())
  customerId      String  @map("customer_id")
  status          String  @default("pending") // pending | paid | shipped | completed | cancelled
  totalAmount     Float   @map("total_amount")
  paymentStatus   String  @default("unpaid") @map("payment_status")
  shippingAddress String? @map("shipping_address")
  tenantId        String  @map("tenant_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@index([tenantId])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  quantity  Int
  unitPrice Float  @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model InventoryTransaction {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  type        String // IN (Purchase/Restock) | OUT (Sale/Order) | ADJUSTMENT
  quantity    Int
  referenceId String?  @map("reference_id") // Order ID or Purchase ID
  notes       String?
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("inventory_transactions")
}

// ─── Financial Tracking (Phase 5) ─────────────────────────

model Expense {
  id          String   @id @default(uuid())
  type        String // RENT | SALARY | MARKETING | LOGISTICS | OTHER
  amount      Float
  description String?
  period      String // YYYY-MM
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([period])
  @@map("expenses")
}
