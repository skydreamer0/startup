{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skydreamer0/startup/architecture-v2/evidence-v1",
  "title": "Architecture v2 evidence record",
  "type": "object",
  "required": ["id", "taskId", "checkIds", "subject", "command", "executor", "recordedAt", "environment", "scope", "result", "exitCode", "artifacts", "limitations"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^AR-[0-9]{2}$"
    },
    "checkIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subject": {
      "type": "object",
      "required": ["sha", "tree", "dirty"],
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "string",
      "minLength": 1
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": ["PASS", "FAIL", "SKIP", "NOT_RUN", "BLOCKED"]
    },
    "exitCode": {
      "type": ["integer", "null"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uri", "sha256"],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": ["object", "null"],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "result": {
          "enum": ["PASS", "FAIL", "NOT_RUN"]
        }
      },
      "required": ["reviewer", "sha", "result"]
    },
    "counts": {
      "type": "object",
      "required": ["passed", "failed", "skipped", "notRun"],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "notRun": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gateIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^G[0-7]$"
      }
    }
  },
  "$comment": "verify-plan validates this format and semantic rules: executed PASS/FAIL require command exit/artifacts; PASS exit 0 clean subject; NOT_RUN/BLOCKED null exit and reason; complete task requires independent review on same SHA and all required checks PASS. This is structural validation, not artifact authentication."
}
